{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jachai benchmark bug case",
  "description": "One bug, described well enough that a tool's answer can be scored without a human re-reading the source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "source", "language", "bug_category", "real_or_synthetic",
    "input", "expected_behavior", "observed_behavior", "ground_truth",
    "jachai_expected", "tool_results"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Stable, unique, lowercase-hyphenated."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "fixture"],
      "properties": {
        "origin": {
          "type": "string",
          "description": "Where the code came from: a repo URL, a session note, or 'authored-for-benchmark'."
        },
        "fixture": {
          "type": "string",
          "description": "Path relative to benchmarks/, e.g. fixtures/valid/empty_average.py"
        },
        "symbol": {
          "type": "string",
          "description": "Function under test, when the fixture holds several."
        },
        "license": {"type": "string"}
      }
    },
    "language": {"type": "string", "enum": ["python"]},
    "bug_category": {
      "type": "string",
      "enum": [
        "crash", "hang", "mutation", "contract", "shared-default",
        "determinism", "logic", "concurrency", "resource", "none", "other"
      ]
    },
    "real_or_synthetic": {
      "type": "string",
      "enum": ["real", "synthetic"],
      "description": "'real' means it was hit during actual work. Code written to demonstrate a bug class is 'synthetic', however realistic it looks."
    },
    "input": {
      "type": "string",
      "description": "The triggering input. Empty only when the defect is static and needs no call."
    },
    "expected_behavior": {"type": "string", "minLength": 1},
    "observed_behavior": {"type": "string", "minLength": 1},
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_bug", "verified_by", "verified_on"],
      "properties": {
        "is_bug": {
          "type": "boolean",
          "description": "false marks a negative control: correct code that must not be flagged."
        },
        "verified_by": {
          "type": "string",
          "minLength": 1,
          "description": "Who confirmed it and how. The literal 'unverified' is rejected by the loader."
        },
        "verified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "evidence": {"type": "string"}
      }
    },
    "jachai_expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["detect", "miss", "skip", "unsupported"],
          "description": "What jachai is expected to do today, not what we wish it did."
        },
        "kind": {"type": "string", "description": "Expected finding kind when outcome is 'detect'."},
        "rationale": {"type": "string"}
      }
    },
    "tool_results": {
      "type": "array",
      "description": "One entry per external tool actually run. An empty array means no tool has been run, which is not the same as a tool finding nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "version", "detected", "run_on", "command"],
        "properties": {
          "tool": {"type": "string"},
          "version": {"type": "string"},
          "detected": {"type": "boolean"},
          "run_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "command": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
